# npm prints a `> pkg@version script` banner for every script it runs, so a
# plain `npm start` buried the daemon's own one-line greeting under seven lines
# of npm — twice over, since `prestart` gets a banner of its own. `silent` is
# the only loglevel that drops it; warn and error both still print it.
#
# It silences npm's *own* logging only. Scripts keep their stdio, so everything
# this project prints — the prestart prompts, the daemon, a check's OK line —
# still appears, including a failing script's stderr.
#
# The one thing it costs: `npm install` reports nothing at all, a failure
# included. Run `npm install --loglevel=warn` when an install looks wrong.
loglevel=silent
