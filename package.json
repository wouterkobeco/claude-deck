{
  "name": "claude-deck",
  "version": "1.1.45",
  "description": "Shows active local Claude Code sessions on a Stream Deck MK.2, colored by state; pressing a button focuses that session's VS Code window.",
  "main": "src/index.mjs",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "prestart": "node scripts/ext-prompt.mjs && node scripts/statusline-prompt.mjs",
    "start": "node src/index.mjs",
    "render-check": "node scripts/render-check.mjs",
    "slots-check": "node scripts/slots-check.mjs",
    "usage-check": "node scripts/usage-check.mjs",
    "stats-check": "node scripts/stats-check.mjs",
    "title-check": "node scripts/title-check.mjs",
    "tasks-check": "node scripts/tasks-check.mjs",
    "subagents-check": "node scripts/subagents-check.mjs",
    "colors-check": "node scripts/colors-check.mjs",
    "terminal-focus-check": "node scripts/terminal-focus-check.mjs",
    "remote-check": "node scripts/remote-check.mjs",
    "ext:install": "node scripts/ext-prompt.mjs --yes",
    "postinstall": "npm run ext:install",
    "board-shot": "node scripts/board-shot.mjs",
    "vscode-state-check": "node scripts/vscode-state-check.mjs",
    "extension-check": "node scripts/extension-check.mjs",
    "statusline:install": "node scripts/statusline-prompt.mjs --yes",
    "statusline-check": "node scripts/statusline-check.mjs",
    "remote:install": "node scripts/remote-install.mjs",
    "remote-install-check": "node scripts/remote-install-check.mjs",
    "config-check": "node scripts/config-check.mjs",
    "history-check": "node scripts/history-check.mjs",
    "tokens-check": "node scripts/tokens-check.mjs"
  },
  "keywords": [
    "claude-code",
    "stream-deck",
    "macos"
  ],
  "author": "wouterkobeco",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@elgato-stream-deck/node": "^7.6.3",
    "qrcode-terminal": "^0.12.0",
    "sharp": "^0.35.3"
  },
  "allowScripts": {
    "node-hid@3.4.0": true,
    "@julusian/jpeg-turbo@3.0.1": true
  }
}
