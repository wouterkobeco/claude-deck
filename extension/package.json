{
  "name": "claude-streamdeck-terminal-focus",
  "displayName": "Claude Deck terminal focus",
  "description": "Reveals the terminal of the Claude Code session whose Stream Deck key was pressed.",
  "version": "1.6.1",
  "publisher": "wouterkobeco",
  "private": true,
  "license": "ISC",
  "categories": [
    "Other"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "claudeStreamdeck.restoreSessions",
        "title": "Restore Claude sessions in this window",
        "category": "Claude Stream Deck"
      },
      {
        "command": "claudeStreamdeck.saveSessionsForTransfer",
        "title": "Backup Claude sessions",
        "category": "Claude Stream Deck"
      },
      {
        "command": "claudeStreamdeck.restoreSessionsFromBundle",
        "title": "Restore Claude sessions from a backup\u2026",
        "category": "Claude Stream Deck"
      }
    ]
  }
}
